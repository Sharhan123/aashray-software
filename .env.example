# Copy to server/.env and replace every placeholder with a secret value.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/aashray_hospitality
SESSION_SECRET=replace-with-at-least-32-random-bytes
COOKIE_SAME_SITE=strict
COOKIE_SECURE=false

# Used only by the one-time bootstrap command. No password is committed.
ENABLE_ADMIN_BOOTSTRAP=false
INITIAL_ADMIN_NAME=Owner
INITIAL_ADMIN_EMAIL=owner@example.com
INITIAL_ADMIN_PASSWORD=

# Reserved for future Meta WhatsApp Cloud API server-side integration.
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
